# 실제 모델 변경은 apps/server/.env에서만 하면 됩니다.
# 이 파일은 새 환경을 만들 때 참고하는 예시입니다.

# Optional: set key to use real OpenAI responses.
OPENAI_API_KEY=

# Optional: set key to enable admin-only usage check API.
ADMIN_API_KEY=

# Optional: persist chat sessions and messages.
# Local SQLite example: sqlite:///./local_chat.db
# Render PostgreSQL example: postgresql://user:password@host:5432/database
DATABASE_URL=

# OpenAI model names
OPENAI_MODEL_NAME=gpt-4.1-mini
OPENAI_GPT_5_4_MODEL_NAME=gpt-5.4

# Optional override
OPENAI_API_BASE_URL=https://api.openai.com/v1

# Optional: Gemini API key
GEMINI_API_KEY=

# Gemini model names
GEMINI_MODEL_NAME=gemini-2.5-flash
GEMINI_3_1_PRO_PREVIEW_MODEL_NAME=gemini-3.1-pro-preview

# Optional override
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional: local OpenAI-compatible endpoint key
LOCAL_AI_API_KEY=

# Local model name
LOCAL_AI_MODEL_NAME=llama3.1

# Local OpenAI-compatible API base URL
LOCAL_AI_API_BASE_URL=http://127.0.0.1:11434/v1

# Local AI speed tuning
LOCAL_AI_MAX_TOKENS=180
LOCAL_AI_HISTORY_MESSAGE_LIMIT=12
LOCAL_AI_NUM_CTX=2048

# Portfolio demo safety limits
# 0 means no limit.
DAILY_AI_REQUEST_LIMIT=100
DAILY_AI_REQUEST_LIMIT_PER_IP=20

# JSON array format
# Example: ["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:19006","http://127.0.0.1:19006","http://localhost:8081","http://127.0.0.1:8081"]
